---
const projects = [
  {
    number: "01",
    category: "FULL-STACK",
    name: "LIBRES",
    description: "A complete platform for managing and reading books.",
    color: "bg-yellow",
    slug: "libres",
  },
  {
    number: "02",
    category: "REAL-TIME",
    name: "ECHO",
    description: "A real-time chat application built around modern web APIs.",
    color: "bg-mint",
    slug: "echo",
  },
  {
    number: "03",
    category: "DESKTOP",
    name: "EDUMANAGE",
    description: "A desktop student management system built with .NET.",
    color: "bg-coral",
    slug: "edumanage",
  },
];
---

<div id="projects" class="mt-24 flex min-h-dvh flex-col gap-8">
  {
    projects.map((project) => (
      <a
        href={`/work/${project.slug}`}
        class="
          group
          block
          min-w-0
          overflow-hidden
          rounded-3xl
          border-[3px]
          border-navy
          bg-paper
          hover:shadow-[10px_10px_0_#172342]
          transition-all
          duration-200
          hover:-translate-y-1

          max-[600px]:rounded-2xl
          max-[600px]:shadow-[7px_7px_0_#172342]
        "
      >
        <!-- Project title -->
        <div
          class={`
            flex
            min-h-56
            min-w-0
            items-end
            justify-between
            gap-6
            p-8
            ${project.color}

            max-[800px]:min-h-48
            max-[800px]:p-7

            max-[600px]:min-h-44
            max-[600px]:gap-4
            max-[600px]:p-6

            max-[400px]:min-h-40
            max-[400px]:p-5
          `}
        >
          <!-- Project info -->
          <div class="min-w-0 flex-1">
            <p
              class="
                text-[clamp(0.65rem,1.5vw,0.75rem)]
                font-black
                tracking-[0.18em]
                text-navy
              "
            >
              {project.number} / {project.category}
            </p>

            <h3
              class="
                mt-3
                min-w-0
                max-w-full
                overflow-hidden
                font-baloo
                text-[clamp(3.2rem,9vw,8rem)]
                font-black
                leading-[0.78]
                tracking-[-0.07em]
                wrap-break-words
                text-navy

                max-[800px]:text-[clamp(3rem,10vw,6rem)]
                max-[600px]:mt-2
                max-[600px]:text-[clamp(2.7rem,13vw,5rem)]
                max-[600px]:tracking-[-0.06em]

                max-[400px]:text-[clamp(2.3rem,15vw,4rem)]
              "
            >
              {project.name}
            </h3>
          </div>

          <!-- Arrow -->
          <span
            class="
              flex
              size-14
              shrink-0
              items-center
              justify-center
              rounded-full
              border-[3px]
              border-navy
              bg-paper
              text-2xl
              font-black
              text-navy
              transition-transform
              duration-300
              group-hover:rotate-45

              max-[800px]:size-12
              max-[800px]:text-xl

              max-[500px]:size-11
              max-[500px]:border-2
              max-[500px]:text-lg

              max-[350px]:size-10
            "
          >
            ↗
          </span>
        </div>

        <!-- Short information -->
        <div
          class="
            flex
            items-center
            justify-between
            gap-8
            border-t-[3px]
            border-navy
            p-7

            max-[800px]:gap-6
            max-[800px]:p-6

            max-[600px]:flex-col
            max-[600px]:items-start
            max-[600px]:gap-5
            max-[600px]:p-6

            max-[400px]:p-5
          "
        >
          <p
            class="
              max-w-150
              text-[clamp(0.9rem,2vw,1rem)]
              leading-[1.6]
              text-navy
            "
          >
            {project.description}
          </p>

          <span
            class="
              shrink-0
              text-[clamp(0.65rem,1.5vw,0.75rem)]
              font-black
              tracking-[0.15em]
              text-navy
            "
          >
            VIEW PROJECT →
          </span>
        </div>
      </a>
    ))
  }

  <!-- View More -->
  <div class="mt-6 flex justify-center">
    <a
      href="/work"
      class="
        group
        inline-flex
        items-center
        gap-3
        rounded-full
        border-[3px]
        border-navy
        bg-yellow
        px-7
        py-4
        text-sm
        font-black
        tracking-[0.12em]
        text-navy
        shadow-[5px_5px_0_#172342]
        transition-all
        duration-200
        hover:-translate-y-1
        hover:shadow-[7px_7px_0_#172342]

        max-[500px]:px-6
        max-[500px]:py-3.5
        max-[400px]:px-5
        max-[400px]:text-xs
      "
    >
      VIEW MORE WORK

      <span
        class="
          text-xl
          transition-transform
          duration-200
          group-hover:translate-x-1
        "
      >
        →
      </span>
    </a>
  </div>
</div>