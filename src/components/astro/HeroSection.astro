---
import { Dot } from "@lucide/astro";
---

<div id="hero" class="bg-yellow w-full min-h-dvh">
  <section
    class="max-w-[90%] mx-auto min-h-dvh w-full grid grid-cols-1 md:grid-cols-2 gap-16 py-32.5 px-[5vw] items-center"
  >
    <!-- hero copy -->
    <div class="flex flex-col items-start">
      <div
        class="inline-flex items-center gap-2 mb-5 text-[0.69rem] bg-navy font-black rounded-3xl pl-2 pr-5 py-2 text-yellow"
      >
        <Dot stroke-width={5} size={20} class="text-orange" />
        <span>AVAILABLE FOR WORK</span>
      </div>

      <p class="text-navy font-bold mb-5">
        <span class="font-medium">HELLO</span>, I'M MOHAMED
      </p>

      <h1
        class="text-navy font-baloo font-black leading-[0.88]
               text-[clamp(4.5rem,7vw,7rem)]
               max-w-225"
      >
        I BUILD<br />
        <span class="text-orange block">REAL</span> PRODUCTS.
      </h1>

      <p
        class="text-navy mt-8 max-w-xl text-base md:text-lg font-medium leading-relaxed"
      >
        Full-stack developer building products from frontend interfaces and APIs
        to databases and deployment.
      </p>

      <div class="flex flex-wrap gap-4 mt-8">
        <a
          href="#work"
          class="inline-flex items-center gap-[1.2rem]
    border-3 border-navy
    rounded-[14px]
    bg-navy
    px-[1.4rem] py-4
    text-[0.75rem] font-black tracking-[0.08em] text-yellow
    transition-all duration-200
    hover:-translate-y-1.25
    hover:-rotate-1
    hover:shadow-[5px_6px_0_#172342]"
        >
          VIEW MY WORK <span class="text-[12px] font-extrabold">→</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-[1.2rem]
    border-3 border-navy
    rounded-[14px]
    bg-white
    px-[1.4rem] py-4
    text-[0.75rem] font-black tracking-[0.08em] text-navy
    transition-all duration-200
    hover:-translate-y-1.25
    hover:-rotate-1
    hover:shadow-[5px_6px_0_#172342]"
        >
          LET'S TALK ↗
        </a>
      </div>
    </div>

    <!-- hero art -->
    <div
      class="relative select-none min-h-100 md:min-h-125 w-full flex items-center justify-center"
      aria-label="Illustration of a full-stack developer toolkit"
    >
      <!-- stars -->
      <span
        class="absolute top-5 left-[12%] text-5xl text-orange rotate-15 font-black"
      >
        ✦
      </span>

      <span
        class="absolute right-[15%] bottom-15 text-3xl text-purple -rotate-12 font-black"
      >
        ✦
      </span>

      <!-- arrow -->
      <span
        class="absolute top-15 right-[22%] text-6xl text-orange rotate-25 font-black"
      >
        ↗
      </span>

      <!-- laptop -->
      <div class="absolute top-[22%] left-[8%] w-[82%] rotate-[-4deg]">
        <!-- screen -->
        <div
          class="relative  h-55 md:h-65 rounded-[18px] border-3 border-navy
             bg-white p-5 md:p-6
             shadow-[10px_12px_0_#172342]"
        >
          <!-- top bar -->
          <div
            class="flex items-center gap-2 border-b-2 border-navy pb-3
               mb-7 font-mono text-xs md:text-sm"
          >
            <span class="text-orange">●</span>
            <span>live_workspace</span>
          </div>

          <!-- code -->
          <div class="font-mono text-sm md:text-base space-y-4">
            <p class="text-[#e5558c]">
              const <b class="text-orange">product</b> = build();
            </p>

            <p class="text-[#3b86d5]">await product.ship();</p>

            <p class="text-[#ed771f]">// make something useful</p>
          </div>

          <!-- screen dot -->
          <div
            class="absolute right-6 bottom-5
               w-10 h-10 rounded-full
               bg-mint border-3 border-navy"
          >
          </div>
        </div>
      </div>

      <!-- DB card -->
      <div
        class="absolute top-0 right-[4%]
           flex flex-col
           rounded-xl border-3 border-navy
           bg-white px-3 py-3
           text-[0.6rem] font-black
           shadow-[5px_6px_0_#172342]
           rotate-8"
      >
        <b class="font-baloo text-3xl leading-none text-purple"> DB </b>

        <span>POSTGRESQL</span>
      </div>

      <!-- API card -->
      <div
        class="absolute bottom-5 left-[2%]
           flex flex-col
           rounded-xl border-3 border-navy
           bg-white px-3 py-3
           text-[0.6rem] font-black
           shadow-[5px_6px_0_#172342]
           -rotate-8"
      >
        <b class="font-baloo text-3xl leading-none text-orange"> API </b>

        <span>● ONLINE</span>
      </div>

      <!-- note -->
      <div
        class="absolute right-[2%] bottom-0
           font-baloo text-lg leading-[1.05]
           rotate-7 text-navy"
      >
        frontend<br />
        + backend<br />
        <b class="text-orange">→ shipped</b>
      </div>
    </div>
  </section>
</div>
